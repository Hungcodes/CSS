# Function to create bar plots for categorical variables
create_bar_plot <- function(data, column, title, x_label) {
  # Create frequency table and convert to data frame
  freq_table <- table(data[[column]])
  freq_df <- as.data.frame(freq_table)
  colnames(freq_df) <- c("Category", "Frequency")
  
  # Create bar plot
  ggplot(freq_df, aes(x = reorder(Category, -Frequency), y = Frequency)) +
    geom_bar(stat = "identity", color = "black", fill = "lightcoral", width = 0.7) +
    labs(title = title, x = x_label, y = "Frequency") +
    theme_bw() +
    theme(plot.title = element_text(hjust = 0.5, size = 12),
          axis.text = element_text(size = 8),
          axis.title = element_text(size = 10),
          axis.text.x = element_text(angle = 45, hjust = 1))  # Rotate x-axis labels for readability
}

