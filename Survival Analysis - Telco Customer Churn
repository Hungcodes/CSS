message("\n\n\n----------Probability Plot - Internet Service----------")
ggsurvplot(
  fit = SA_IntSer,
  data = SA_data,
  pval = TRUE,
  conf.int = TRUE,
  risk.table = TRUE,
  surv.median.line = "hv",
  xlab = "Tenure",
